# --- Servidor ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Google Sheets ---
# Deja GOOGLE_SHEETS_ID vacío para desarrollar con datos mock (el backend
# servirá datos ficticios y avisará por consola). Cuando quieras conectar
# la hoja real, rellena ambos: ID + service account.
GOOGLE_SHEETS_ID=
SHEETS_ITEMS_TAB=items
SHEETS_CACHE_TTL_SEC=20

# Credenciales — usa una de las dos.
# 1) Ruta al JSON de service account (fuera del repo). Recomendado en dev.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# 2) JSON en base64 — recomendado en producción (Railway, Vercel, etc.).
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Silencia el warning "Sheets no configurado, sirviendo mock" en dev.
LOG_SHEETS_FALLBACK=true

# --- Auth (Fase 3) ---
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Rate limit ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5

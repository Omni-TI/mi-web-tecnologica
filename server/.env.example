# --- Servidor ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Google Sheets ---
# El backend tiene 3 modos automáticos según lo que configures aquí:
#
#   A) MODO CSV PÚBLICO (más simple, SOLO LECTURA — recomendado para el catálogo)
#      Solo pon el ID de tu hoja. La hoja debe estar compartida como
#      "Cualquiera con el enlace: Lector". No requiere Google Cloud ni credenciales.
#      El panel admin podrá ver el inventario pero NO escribir de vuelta a la hoja.
#
#   B) MODO SERVICE ACCOUNT (lectura + ESCRITURA — para que el admin edite la hoja)
#      Pon el ID + las credenciales de service account (ver docs/GOOGLE_SHEETS_SETUP.md)
#      y comparte la hoja con el email de la service account como Editor.
#
#   C) MODO LOCAL (deja GOOGLE_SHEETS_ID vacío) → datos mock / JSON local para dev.

# ID de tu hoja (el segmento entre /d/ y /edit de la URL).
GOOGLE_SHEETS_ID=1gtDZbyLpoUCb8BUCYKWVB_QN2RambooTc4tv9a1z4w0
# gid de la pestaña con los datos (0 = primera pestaña). Solo modo CSV público.
GOOGLE_SHEETS_GID=0
# Nombre de la pestaña (solo modo service account).
SHEETS_ITEMS_TAB=items
SHEETS_CACHE_TTL_SEC=20

# Credenciales de service account — SOLO si quieres el modo B (escritura).
# Déjalas vacías para usar el modo A (CSV público, solo lectura).
GOOGLE_SERVICE_ACCOUNT_FILE=
# JSON en base64 — recomendado en producción (Railway, Vercel, etc.).
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Silencia el warning "Sheets no configurado, sirviendo mock" en dev.
LOG_SHEETS_FALLBACK=true

# --- Auth (Fase 3) ---
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Rate limit ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5

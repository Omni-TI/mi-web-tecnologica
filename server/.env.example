# --- Servidor ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Google Sheets ---
GOOGLE_SHEETS_ID=
# Ruta al JSON de service account (fuera del repo).
# En producción prefiere GOOGLE_SERVICE_ACCOUNT_JSON con el JSON en base64.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# --- Auth ---
JWT_ACCESS_SECRET=change_me_generate_with_openssl
JWT_REFRESH_SECRET=change_me_generate_with_openssl
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# --- Rate limit ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=5
